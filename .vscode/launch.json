{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Docker: Attach to Node (Debug)",
      "port": 9229,
      "address": "localhost",
      
      // ✅ КЛЮЧЕВОЙ МОМЕНТ 1: Локальный корневой путь (папка, открытая в VS Code)
      "localRoot": "${workspaceFolder}/backend",
      
      // ✅ КЛЮЧЕВОЙ МОМЕНТ 2: Удаленный корневой путь (рабочая директория в контейнере)
      "remoteRoot": "/app", 
      
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/backend/dist/**/*.js"
      ]
    },
    {
      "name": "Debug Frontend (Vite)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    }    
  ]
}