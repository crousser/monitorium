{
  "name": "monorepo",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:back": "dotenv -e ./.env -- npm run start:dev --workspace=back",
    "dev:front": "dotenv -e ./.env -- npm run dev --workspace front",
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.1"
  }
}
