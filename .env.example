API_PORT=0000 # <- ЗАМЕНИТЬ, порт backend-сервера
VITE_API_PORT="${API_PORT}"
VITE_FRONTEND_PORT=0000 # <- ЗАМЕНИТЬ, порт сервера фронтенд разработки
ALLOWED_ORIGINS="http://localhost:${VITE_FRONTEND_PORT}"

POSTGRES_HOST="localhost"
POSTGRES_PORT=0000 # <- ЗАМЕНИТЬ, порт доступа к БД
POSTGRES_DB="dbname" # <- ЗАМЕНИТЬ, название БД
POSTGRES_USER="username" # <- ЗАМЕНИТЬ, пользователя БД
POSTGRES_PASSWORD="Abc123" # <- ЗАМЕНИТЬ, пароль пользователя БД
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

JWT_ACCESS_SECRET="jwt_access_secret" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="jwt_refresh_secret" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ
JWT_REFRESH_EXPIRES="30d"
JWT_REFRESH_SALT="jwt_refresh_salt" # <- ЗАМЕНИТЬ,  cгенерируйте случайный ключ